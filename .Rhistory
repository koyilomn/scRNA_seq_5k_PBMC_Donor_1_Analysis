#On the 10x Genomics Datasets Portal, files are nested inside individual project pages rather than being displayed on one giant download page.
Here is exactly how to navigate to the download files step-by-step:
# Install Seurat and HDF5 reader packages if you don't have them
install.packages("Seurat")
install.packages("hdf5r") # Required to read .h5 files
# Load the libraries
library(Seurat)
library(dplyr)
library(ggplot2)
# 1. Read the H5 matrix file
counts_matrix <- Read10X_h5("sample_feature_bc_matrix.h5")
# 1. Read the H5 matrix file
counts_matrix <- Read10X_h5("sample_feature_bc_matrix.h5")
setwd("~/")
# 1. Read the H5 matrix file
counts_matrix <- Read10X_h5("sample_feature_bc_matrix.h5")
# 2. Create a Seurat Object
# We filter out very poor cells right at the start (cells must have at least 200 genes)
seurat_obj <- CreateSeuratObject(counts = counts_matrix,
project = "scRNA_Practice",
min.cells = 3,
min.features = 200)
# Look at your initial object summary
print(seurat_obj)
#Step 3 Quality control and filtering
# 1. Calculate mitochondrial gene percentage (starts with "MT-" in humans)
seurat_obj[["percent.mt"]] <- PercentageFeatureSet(seurat_obj, pattern = "^MT-")
# 2. Visualize QC metrics before filtering
VlnPlot(seurat_obj, features = c("nFeature_RNA", "nCount_RNA", "percent.mt"), ncol = 3)
# 3. Filter out bad cells (adjust thresholds based on your violin plot)
# Standard practice: Remove cells with >5% mitochondrial genes or extreme gene counts
seurat_obj <- subset(seurat_obj, subset = nFeature_RNA > 200 &
nFeature_RNA < 2500 &
percent.mt < 5)
#Step 4: Normalization and Finding Variable Feature
# 1. Normalize the data (LogNormalize scales data to 10,000 reads per cell)
seurat_obj <- NormalizeData(seurat_obj, normalization.method = "LogNormalize", scale.factor = 10000)
# 2. Identify highly variable genes (usually top 2000)
seurat_obj <- FindVariableFeatures(seurat_obj, selection.method = "vst", nfeatures = 2000)
# Plot top 10 most variable genes just to look at them
top10 <- head(VariableFeatures(seurat_obj), 10)
LabelPoints(plot = VariableFeaturePlot(seurat_obj), points = top10, repel = TRUE)
#Step 5: caling the Data and Dimensionality Reduction
# 1. Scale the data
all.genes <- rownames(seurat_obj)
seurat_obj <- ScaleData(seurat_obj, features = all.genes)
# 2. Run PCA
seurat_obj <- RunPCA(seurat_obj, features = VariableFeatures(object = seurat_obj))
# 3. Visualize PCA results
DimPlot(seurat_obj, reduction = "pca")
ElbowPlot(seurat_obj) # Helps you decide how many PCs to use (where the curve flattens)
# 1. Grab the standard deviations from your Seurat PCA slot
stdevs <- seurat_obj[["pca"]]@stdev
# 2. Square them to get the variance, then calculate the coverage percentage
pc_coverage <- (stdevs^2 / sum(stdevs^2)) * 100
# 3. Create a clean breakdown table
data_coverage_table <- data.frame(
PC = paste0("PC-", 1:length(pc_coverage)),
Data_Covered_Percent = round(pc_coverage, 2),
Total_Cumulative_Covered = round(cumsum(pc_coverage), 2)
)
# 4. Print the table to your console
print(data_coverage_table)
library(ggplot2)
# 1. Ensure you have calculated the coverage array from the previous step
stdevs <- seurat_obj[["pca"]]@stdev
pc_coverage <- (stdevs^2 / sum(stdevs^2)) * 100
data_coverage_table <- data.frame(
PC = factor(paste0("PC-", 1:length(pc_coverage)), levels = paste0("PC-", 1:length(pc_coverage))),
Data_Covered_Percent = pc_coverage
)
# 2. Build the ggplot bar graph (looking at the top 20 PCs)
coverage_barplot <- ggplot(data_coverage_table[1:20, ], aes(x = PC, y = Data_Covered_Percent)) +
geom_bar(stat = "identity", fill = "skyblue", color = "black") +
geom_text(aes(label = paste0(round(Data_Covered_Percent, 1), "%")), vjust = -0.5, size = 3) +
theme_classic() +
labs(
title = "Data Coverage per Principal Component",
x = "Principal Components",
y = "Percentage of Total Data Covered (%)"
) +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# 3. View the plot in RStudio
print(coverage_barplot)
# 4. Save/Download the bar graph to your folder
ggsave(filename = "PCA_Data_Coverage_BarGraph.png", plot = coverage_barplot, width = 8, height = 5, dpi = 300)
# 1. Generate the standard Seurat PCA plot and save it to a variable
my_pca_plot <- DimPlot(seurat_obj, reduction = "pca")
# 2. View the plot in RStudio
print(my_pca_plot)
# 3. Save/Download the PCA plot to your folder
ggsave(filename = "Seurat_PCA_DimPlot.png", plot = my_pca_plot, width = 7, height = 6, dpi = 300)
#Step 6: Clustering Cells
#Based on the PCA dimensions (we will use the first 10 PCs here), Seurat groups cells with similar expression patterns into distinct clusters.
# 1. Find neighboring cells
seurat_obj <- FindNeighbors(seurat_obj, dims = 1:10)
# 2. Cluster cells (Resolution around 0.5-0.8 is standard for blood/immune datasets)
seurat_obj <- FindClusters(seurat_obj, resolution = 0.5)
# View active cluster assignments for the first few cells
head(Idents(seurat_obj), 5)
#Step 7: Visualization (UMAP/t-SNE)
#To see your clusters in 2D space, you generate a UMAP plot. Cells that are close together are biologically similar.
# 1. Run UMAP
seurat_obj <- RunUMAP(seurat_obj, dims = 1:10)
# 2. Plot the results
DimPlot(seurat_obj, reduction = "umap", label = TRUE)
# 1. Check your current cluster numbers to see how many you have
print(levels(seurat_obj))
# 2. Define the cell names matching your cluster order (0, 1, 2, 3...)
# NOTE: Replace these names with the actual cell types you find in your marker analysis!
# This example maps 5 standard clusters for a PBMC dataset:
cell_names <- c("0" = "CD4+ T-Cells",
"1" = "B-Cells",
"2" = "CD8+ T-Cells",
"3" = "NK Cells",
"4" = "Monocytes")
# 3. Rename the clusters in your Seurat object
seurat_obj <- RenameIdents(seurat_obj, cell_names)
# 4. Run UMAP (if you haven't run it yet)
seurat_obj <- RunUMAP(seurat_obj, dims = 1:10)
# 5. Plot the results with larger dots
# pt.size changes the dot size (default is usually ~0.5 or 1, increasing to 1.5 makes them bigger)
DimPlot(seurat_obj, reduction = "umap", label = TRUE, pt.size = 1.5) +
theme(legend.text = element_text(size = 12)) # Optional: makes the legend font easy to read
#Step 8
# 1. Find markers for all clusters compared to all other cells
cluster_markers <- FindAllMarkers(seurat_obj, only.pos = TRUE, min.pct = 0.25, logfc.threshold = 0.25)
# 2. View the top 2 marker genes for each cluster
cluster_markers %>% group_by(cluster) %>% slice_max(n = 2, order_by = avg_log2FC)
# 3. Plot a specific gene of interest to see where it is expressed
# (e.g., MS4A1 is a classic B-cell marker, CD3E is a T-cell marker)
FeaturePlot(seurat_obj, features = c("MS4A1", "CD3E"))
#Step 9
# STEP 2: View the top 2 marker genes for each named cell type
# ==============================================================================
# The printed table will show the cell names instead of numerical cluster IDs
named_top_markers <- cluster_markers %>%
group_by(cluster) %>%
slice_max(n = 2, order_by = avg_log2FC)
print(named_top_markers)
#Step 10
# STEP 3: Plot expression profiles across your named cell groups
# ==============================================================================
# FeaturePlot draws individual panels per gene. If you want a view grouped by
# your cell names, VlnPlot (Violin Plot) is highly recommended for marker genes.
FeaturePlot(seurat_obj, features = c("MS4A1", "CD3E"))
# Alternative recommendation: A violin plot to compare expression levels
# directly across your newly named cell types with larger points
VlnPlot(seurat_obj, features = c("MS4A1", "CD3E"), pt.size = 0.5)
# Navigate to your project folder
cd /path/to/your/single_cell_project
